# Copy file này thành .env và điền giá trị thực
# cp .env.example .env

# ── Spring ───────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update
TZ=Asia/Ho_Chi_Minh

# ── MySQL ────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=demo_db

# ── Spring Datasource ────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/demo_db?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=1234567890

# ── Docker ───────────────────────────────────
DOCKERHUB_USERNAME=your_dockerhub_username
IMAGE_NAME=your_dockerhub_username/demo-cicd:latest
